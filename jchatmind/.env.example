# 复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 忽略，不会提交）
# 数据库
DB_USERNAME=root
DB_PASSWORD=你的数据库密码
# QQ 邮箱（QQ邮箱 → 设置 → 账户 → 开启 SMTP 服务获取授权码）
MAIL_USERNAME=你的QQ邮箱@qq.com
MAIL_PASSWORD=邮箱授权码
# DeepSeek 开放平台 https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxx
# 智谱开放平台 https://open.bigmodel.cn
ZHIPU_API_KEY=xxx.xxx
